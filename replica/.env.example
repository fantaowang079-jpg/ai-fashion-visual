# ── 火山方舟（Seedream 生图 / Seedance 视频）──────────────
# https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL_PRO=doubao-seedance-1-5-pro-251215
ARK_VIDEO_MODEL_LITE=doubao-seedance-1-0-lite-i2v-250428

# ── 阿里云百炼（图像编辑试衣 / qwen-vl 服装分析）───────────
# https://bailian.console.aliyun.com  （地域选“中国内地（北京）”）
# 注意：这里要填“API-KEY 管理”里创建的 sk- 开头 API Key，
#       不是 RAM 的 AccessKey ID/Secret（LTAI...），后者不能调模型。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：业务空间专属地址（控制台 API-KEY 页会显示调用地址）
# 若 AI 试衣报 “Model not exist”，把下面换成业务空间地址，例如：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_NATIVE_BASE_URL=
QWEN_VL_MODEL=qwen-vl-max
# 智能穿搭使用的文本模型（需账号可用；qwen-plus 额度耗尽时可选 glm-5.2-fast-preview）
STYLIST_MODEL=qwen-plus
# 图生视频（百炼万相）；480P 约 ¥0.3/秒、720P ¥0.6/秒、1080P ¥1/秒
WAN_VIDEO_MODEL=wan2.5-i2v-preview
# 视频单价（元/秒），按分辨率
WAN_VIDEO_PRICES=480P=0.3,720P=0.6,1080P=1.0

# ── 账户余额查询（可选）──────────────────────────────────
# 百炼 sk- 开头的 API Key 没有余额接口；查询真实余额需要阿里云 AccessKey。
# 建议创建 RAM 用户并只授予只读权限 AliyunBSSReadOnlyAccess，不要用主账号 AccessKey。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
BSS_ENDPOINT=https://business.aliyuncs.com
# 余额 / 额度入口是否显示（默认隐藏；设为 1 后重启）
BALANCE_UI_ENABLED=0
# 试衣引擎：edit=qwen-image 图像编辑（默认）；aitryon=专用试衣模型（需账号开通）
TRYON_ENGINE=edit
TRYON_MODEL=qwen-image-3.0
# 若改用专用试衣：
# TRYON_ENGINE=aitryon
# TRYON_MODEL=aitryon-plus

# ── AI 换装（qwen-image 指令编辑）─────────────────────────
# 默认主模型；不存在时依次尝试下面的备选
QWEN_IMAGE_EDIT_MODEL=qwen-image-3.0
QWEN_IMAGE_EDIT_FALLBACKS=qwen-image-2.1-pro,qwen-image-2.0

# 成本台账估算单价（元/张），实际以控制台账单为准
# 可加试衣/方舟模型：aitryon-plus=0.5,doubao-seedream-5-0-260128=0.25
QWEN_IMAGE_EDIT_PRICES=qwen-image-3.0=0.5,qwen-image-2.1-pro=0.3,qwen-image-2.0=0.2,aitryon-plus=0.5,doubao-seedream-5-0-260128=0.25

# ── 输出目录（留空则使用 replica/output/）─────────────────
TRYON_OUTPUT_DIR=
